{#- Macros the default template is built from. Each part that renders a section
    starts with the newlines that separate it from the part before, so parts
    can be placed one after another with {{- }} -#}

{%- macro avatar_url(url, size) -%}
{{ url }}{% if "?" in url %}&{% else %}?{% endif %}size={{ size }}&width={{ size }}
{%- endmacro -%}

{%- macro commit_contributors(commit) -%}
{%- if commit.contributors %} ({{ commit.contributors | mention | join(", ") }}){% endif -%}
{%- endmacro -%}

{%- macro contributor_link(contributor) -%}
{%- if contributor.is_ai -%}
**`{{ contributor.count }}`** commit{% if contributor.count != 1 %}s{% endif %}
{%- else -%}
{%- set since = contributor.first_commit_timestamp | date(format="%Y-%m-%d") -%}
{%- set until = contributor.last_commit_timestamp | date(format="%Y-%m-%d") -%}
{%- set url = contributor_commits_url(author=contributor.username, since=since, until=until) -%}
{%- if url -%}
[**`{{ contributor.count }}`**]({{ url }}) commit{% if contributor.count != 1 %}s{% endif %}
{%- else -%}
**`{{ contributor.count }}`** commit{% if contributor.count != 1 %}s{% endif %}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro entry(commit) -%}
- {{ commit_url(sha = commit.hash) }} {{ commit.description }}{{ commit_contributors(commit=commit) }}
{%- if commit.body %}

{{ commit.body | unwrap | indent(2, first=true) }}
{%- endif %}
{%- if commit.breaking_description %}

> [!IMPORTANT]
{{ "> " ~ (commit.breaking_description | unwrap) | replace("\n", "\n> ") }}
{%- endif -%}
{%- endmacro -%}

{%- macro section(heading, commits, entry=entry, level=2) -%}
{%- if commits %}
{{ "#" * level }} {{ heading }}
{%- for commit in commits %}
{{ entry(commit) }}
{%- endfor %}
{%- endif -%}
{%- endmacro -%}

{%- macro header(date_format="%B %d, %Y") -%}
## {{ git_ref }} - {{ release_date | date(format=date_format) }}
{%- endmacro -%}

{%- macro _stat(count, label, anchor, link) -%}
{%- if link -%}
[**`{{ count }}`**](#{{ anchor }}) {{ label }}
{%- else -%}
**`{{ count }}`** {{ label }}
{%- endif -%}
{%- endmacro -%}

{%- macro stats(breaking, features, fixes, link=true) -%}
{%- set stats = [] -%}
{%- if breaking -%}
  {%- set n = breaking | length -%}
  {%- set stats = stats + [_stat(n, "breaking change" if n == 1 else "breaking changes", "breaking-changes", link)] -%}
{%- endif -%}
{%- if features -%}
  {%- set n = features | length -%}
  {%- set stats = stats + [_stat(n, "new feature" if n == 1 else "new features", "new-features", link)] -%}
{%- endif -%}
{%- if fixes -%}
  {%- set n = fixes | length -%}
  {%- set stats = stats + [_stat(n, "bug fixed" if n == 1 else "bug fixes", "bug-fixes", link)] -%}
{%- endif -%}
{%- if stats %}

{{ stats | join(" • ") }}
{% endif -%}
{%- endmacro -%}

{%- macro contributors(humans, heading="Contributors") -%}
{%- if humans %}
## {{ heading }}
{%- for contributor in humans %}
- <img src="{{ avatar_url(url=contributor.avatar_url, size=20) }}" width="20" height="20" align="center">&nbsp;&nbsp;@{{ contributor.username }} ({{ contributor_link(contributor=contributor) }})
{%- endfor %}
{% endif -%}
{%- endmacro -%}

{%- macro dependencies(commits, heading="Dependency Updates") -%}
{%- if commits %}
## {{ heading }}

| Commit | Update | Contributors |
|--------|--------|--------------|
{%- for commit in commits %}
| {{ commit_url(sha = commit.hash) }} | {{ commit.description | table_escape }} |{% if commit.contributors %} {{ commit.contributors | mention | join(", ") }}{% endif %} |
{%- endfor %}
{%- endif -%}
{%- endmacro -%}

{%- macro compare() -%}
{%- set url = compare_url() -%}
{%- if url %}

**Full Changelog**: [`{{ to_ref }}...{{ from_ref }}`]({{ url }})
{%- endif -%}
{%- endmacro -%}

{%- macro credit() %}

*Generated with [release-note](https://github.com/purpleclay/release-note)*
{%- endmacro -%}
